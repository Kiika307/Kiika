NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# RGPD art. 20 — Portabilité des données (export JSON par client).
# Désactivé par défaut. Mettre "true" pour activer la fonctionnalité d'export
# côté UI thérapeute. À n'activer que sur décision de l'éditeur (INTIO).
KIIKA_ENABLE_DATA_EXPORT=false

# KIIKA Assistant — Analyse approfondie par LLM (Anthropic Claude).
# Désactivé par défaut. Pour activer :
#   1. Créer une clé API sur https://console.anthropic.com/
#   2. Provisionner du budget (~0.01-0.05€/analyse avec Sonnet)
#   3. Mettre les 2 vars ci-dessous à leurs valeurs réelles
#   4. Mettre à jour la politique de confidentialité pour mentionner Anthropic
KIIKA_ENABLE_LLM_ANALYSIS=false
ANTHROPIC_API_KEY=

# Envoi des invitations Selene par e-mail (SMTP SiteGround / boîte KIIKA).
# La même boîte que celle déjà utilisée par Supabase pour les e-mails d'auth.
# Configuration en production :
#   1. Récupérer les coordonnées SMTP depuis Site Tools SiteGround
#      (Email > Accounts > [adresse] > Connect Devices) :
#        - Hostname (ex. mail.kiika.intio.fr ou smtpout.siteground.com)
#        - Port 465 (SSL recommandé) ou 587 (STARTTLS)
#        - Username = adresse complète (ex. selene@kiika.intio.fr)
#        - Password = mot de passe de la boîte mail
#   2. Coller les valeurs dans Vercel > Project > Settings > Environment Variables
#   3. EMAIL_FROM doit être une adresse hébergée sur la boîte (sinon SPF/DKIM
#      du domaine ne signera pas et le message tombera en spam).
#   4. Sans configuration : le bouton "Envoyer via KIIKA" affiche une erreur,
#      les utilisateurs peuvent toujours utiliser "Copier le lien" / "Mon client mail".
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=true
EMAIL_FROM="KIIKA <selene@kiika.intio.fr>"

# URL absolue de production utilisée dans les liens d'invitation Selene.
# Par défaut https://kiika.intio.fr. À surcharger en preview/staging.
NEXT_PUBLIC_APP_URL=https://kiika.intio.fr
